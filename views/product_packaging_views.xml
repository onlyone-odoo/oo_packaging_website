<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_packaging_list_view_stock_inherit_website_packaging" model="ir.ui.view">
        <field name="name">product.packaging.list.view.stock.website.packaging</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="stock.product_packaging_tree_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="after">
                <field name="packaging_discount" optional="show"/>
                <field name="website_published" optional="show"/>
                <field name="website_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>


    <record id="product_template_variant_list_website_force_packaging" model="ir.ui.view">
        <field name="name">product.template.variant.list.website.force.packaging</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_variant_ids']/list" position="inside">
                <field name="website_force_packaging" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_website_force_packaging" model="ir.ui.view">
        <field name="name">product.product.form.website.force.packaging</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="website_force_packaging"/>
            </xpath>
        </field>
    </record>

</odoo>
