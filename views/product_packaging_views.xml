<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_packaging_list_view_stock_inherit_website_packaging" model="ir.ui.view">
        <field name="name">product.packaging.list.view.stock.website.packaging</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="stock.product_packaging_tree_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="after">
                <field name="packaging_discount" optional="show"/>
                <field name="website_published" optional="show"/>
                <field name="website_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>


    <!-- Odoo 18: product_template_only_form_view has no embedded product_variant_ids list;
         variants use product_variant_easy_edit_view from the Variants stat button. -->
    <record id="product_variant_easy_edit_view_website_force_packaging" model="ir.ui.view">
        <field name="name">product.product.variant.easy.website.force.packaging</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='codes']/field[@name='barcode']" position="after">
                <field name="website_force_packaging"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_website_force_packaging" model="ir.ui.view">
        <field name="name">product.product.form.website.force.packaging</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="website_force_packaging"/>
            </xpath>
        </field>
    </record>

</odoo>
