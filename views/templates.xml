<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product page: packaging selector (inside add_to_cart_wrap, before quantity) -->
    <template id="product_inherit_website_packaging" inherit_id="website_sale.product_quantity" name="Product packaging selector">
        <xpath expr="//div[@id='add_to_cart_wrap']/div[contains(@class, 'css_quantity')]" position="before">
            <t t-if="has_website_packagings">
                <div class="oo_packaging_selector_inline me-2 mb-2 align-middle">
                    <owl-component name="oo_packaging_website.PackagingSelector" t-att-props="website_packagings_by_variant_json"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Labels for packaging (so they can be overridden/translated) -->
    <template id="o_wsale_product_packaging_label" name="Packaging">
        <t t-out="'Packaging'"/>
    </template>
    <template id="o_wsale_product_packaging_no_packaging" name="No packaging">
        <t t-out="'Unit'"/>
    </template>

    <!-- Cart: show packaging and discount per line.
         Disabled: Odoo 18 website_sale.cart_lines structure differs from older versions.
         To restore: inspect the cart_lines template in your Odoo instance and use the
         correct xpath for the line container (e.g. //div[hasclass('...')] or //t[@t-as='...']).
    <template id="cart_lines_inherit_website_packaging" inherit_id="website_sale.cart_lines" name="Cart line packaging info">
        <xpath expr="//div[contains(@class, 'o_wsale_product_name') or contains(@class, 'product_name')]" position="after">
            <t t-set="line_packaging" t-value="line.product_packaging_id"/>
            <div class="o_wsale_line_packaging_info text-muted small" t-if="line_packaging">
                <span class="o_wsale_line_packaging_name" t-field="line_packaging.name"/>
                <t t-if="line.discount"> — </t>
                <span class="o_wsale_line_discount_badge badge bg-success" t-if="line.discount">
                    -<t t-esc="int(line.discount)"/>%
                </span>
            </div>
        </xpath>
    </template>
    -->

</odoo>
