<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <template
        id="product_inherit_website_packaging"
        inherit_id="website_sale.product_quantity"
        name="Product packaging selector">
        <xpath expr="//div[contains(@t-attf-class, 'css_quantity')]" position="before">
            <t t-if="has_website_packagings">
                <div class="oo_packaging_selector_inline me-2 mb-2 align-middle">
                    <owl-component 
                        name="oo_packaging_website.PackagingSelector" 
                        t-att-props="website_packagings_by_variant_json"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Cart: inject packaging step into the quantity input so JS can
         enforce +/- by packaging qty instead of ±1. -->
    <template
        id="cart_lines_packaging_step"
        inherit_id="website_sale.cart_lines"
        name="Cart packaging quantity step">
        <xpath expr="//input[hasclass('js_quantity')]" position="attributes">
            <attribute name="t-att-data-packaging-qty">
                line.product_packaging_id.qty if line.product_packaging_id else 0
            </attribute>
        </xpath>
    </template>

    <!-- Labels for packaging (so they can be overridden/translated) -->
    <template id="o_wsale_product_packaging_label" name="Packaging">
        <t t-out="'Packaging'"/>
    </template>
    <template id="o_wsale_product_packaging_no_packaging" name="No packaging">
        <t t-out="'Unit'"/>
    </template>

    <!-- Display packaging info and discount badge in cart lines (Odoo 18: flex layout, no table). -->
    <template
        id="cart_line_packaging_info"
        inherit_id="website_sale.cart_lines"
        name="Cart line packaging info">
        <xpath expr="//div[@name='o_wsale_cart_line_button_container']" position="before">
            <t t-if="line.product_packaging_id">
                <div class="o_wsale_line_packaging_info small text-muted mt-1">
                    <t t-call="o_wsale_product_packaging_label"/>:
                    <strong><t t-esc="line.product_packaging_id.name"/></strong>
                    <t t-if="line.discount &gt; 0">
                        <span class="o_wsale_line_discount_badge badge bg-success ms-1">
                            -<t t-esc="line.discount"/>%
                        </span>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
